---
import Layout from "~/layouts/Layout.astro";
import { services } from "~/lib/services";
---

<Layout
  title="Usługi"
  description="PPF, oklejanie folią, przyciemnianie szyb i detailing — Diamond Touch Studio, Ostrów Mazowiecka."
>
  <section class="container-page pt-12 pb-16 md:pt-16">
    <header class="max-w-2xl">
      <p class="text-brand-400 uppercase tracking-[0.2em] text-xs">Oferta</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-display">Usługi</h1>
      <p class="mt-4 text-fg-muted">
        Poniżej znajdziesz zakres naszych usług. Ostateczna cena zawsze ustalana
        jest po konsultacji i zależy od specyfiki realizacji.
      </p>
    </header>

    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {
        services.map((s) => (
          <li class="group rounded-2xl border border-border bg-elevated p-6 transition-colors hover:border-brand-500">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-xl font-display">
                <a
                  href={`/uslugi/${s.slug}`}
                  class="hover:text-brand-400"
                >
                  {s.title}
                </a>
              </h2>
            </div>
            <p class="mt-3 text-fg-muted">{s.listDescription}</p>
            <a
              href={`/uslugi/${s.slug}`}
              class="mt-4 inline-block text-sm text-brand-400 hover:text-brand-300"
            >
              Czytaj więcej →
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-12">
      <a
        href="/kontakt"
        class="btn btn-primary"
        data-track='{"event":"click_cta","label":"umow_konsultacje","page":"uslugi"}'
      >
        Umów konsultację
      </a>
    </div>
  </section>
</Layout>
